graph LR
    PG[(PostgreSQL\nsubscriptions · repositories\ndetected_releases · outbox)]
    GH[GitHub API]
    SMTP[SMTP]

    subgraph API["Binary — api"]
        subgraph SUB["internal/subscription"]
            SHDL["Handler"]
            SSVC["Service"]
            SSTORE["store 🔒"]
        end
        subgraph CAT["internal/catalog"]
            CSVC["Service"]
            CSTORE["store 🔒"]
        end
        subgraph MON["internal/monitoring"]
            WORK["Worker · every 25 s"]
        end
        subgraph FANOUT["internal/fanout"]
            FW["Worker · every 1 s"]
            FENQ["Enqueue"]
        end
        subgraph OUTBOX["internal/outbox"]
            OINS["Insert"]
            RELAY["Relay · every 1 s"]
        end
    end

    subgraph CONTRACT["contract — shared go module"]
        EVT["ConfirmationRequested · ReleaseDetected · DeadLetter\nStream · Subject · StreamDLQ · SubjectDead constants"]
    end

    subgraph NATS_SVC["NATS JetStream — Stream: NOTIFICATIONS\nStorage: File · Subjects: notifications.> · Duplicates: 2 min"]
        NC["notifications.confirmation"]
        NR["notifications.release"]
    end

