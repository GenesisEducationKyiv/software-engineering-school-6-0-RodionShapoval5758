# This is a reference of every variable the system uses, grouped by the
# service that reads it — it's not meant to be sourced as one flat file.
#
# `docker compose up` only substitutes ${GITHUB_TOKEN} from a root .env file
# (see compose.yaml); every other value below is already hardcoded in
# compose.yaml for the docker-based stack. Use the per-service sections here
# when running an individual service locally via `go run` instead of Docker.

# ── Read by docker compose (subscription + monitoring) ──────────────────────
GITHUB_TOKEN=

# ── Auth service (services/auth) ────────────────────────────────────────────
DATABASE_URL="postgres://postgres:password@localhost:5432/auth?sslmode=disable"
PORT="8080"
GRPC_PORT="50051"
NATS_URL="nats://localhost:4222"
JWT_PRIVATE_KEY="./certs/jwt-signing.key"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="720h"
VERIFY_TOKEN_TTL="24h"
GRPC_TLS_CA_CERT="./certs/ca.crt"
GRPC_TLS_CERT="./certs/auth.crt"
GRPC_TLS_KEY="./certs/auth.key"

# ── Subscription service (services/subscription) ────────────────────────────
# DATABASE_URL, PORT, GRPC_PORT, NATS_URL, GRPC_TLS_CA_CERT: same shape as
# Auth above, but pointed at the subscription DB and subscription.crt/key.
DATABASE_URL="postgres://postgres:password@localhost:5432/github_release_notifications?sslmode=disable"
AUTH_GRPC_ADDR="localhost:50051"
GRPC_TLS_CERT="./certs/subscription.crt"
GRPC_TLS_KEY="./certs/subscription.key"

# ── Monitoring service (services/monitoring) ─────────────────────────────────
# DATABASE_URL: same subscription DB as above (monitoring shares that instance).
SCAN_INTERVAL="25s"
SUBSCRIPTION_GRPC_ADDR="localhost:50051"
GRPC_TLS_CERT="./certs/monitoring.crt"
GRPC_TLS_KEY="./certs/monitoring.key"

# ── Notification service (services/notification) ────────────────────────────
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
SENDER_EMAIL="noreply@localhost"
MAIN_URL="http://localhost"
